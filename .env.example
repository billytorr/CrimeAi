# ─────────────────────────────────────────────────────────────
# PSCC / CrimeAI — Miami MVP environment
# Copy this file to `.env.local` and fill in what you have.
# The app RUNS WITH ZERO KEYS (uses a grounded fallback brain +
# free OpenStreetMap tiles). Add keys to upgrade quality.
# ─────────────────────────────────────────────────────────────

# 1) CrimeAI brain. Pick ONE (in priority order):
#    a) Anthropic Claude (best for a live investor demo).
ANTHROPIC_API_KEY=
#    Model id — defaults to claude-opus-4-8 if unset.
CRIMEAI_MODEL=claude-opus-4-8

#    b) Local Ollama running your existing torr-crimeai model.
#       If ANTHROPIC_API_KEY is empty and Ollama is reachable, the
#       app uses this automatically.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=torr-crimeai

# 2) Geocoding (address -> lat/lon). Optional.
#    Without a key the app uses a built-in Miami gazetteer + free
#    OpenStreetMap Nominatim. Add a Mapbox token for full coverage.
MAPBOX_TOKEN=

# 3) Live data toggle. When "true", the ingestor also tries the
#    Miami-Dade open-data adapter; otherwise it serves the seeded
#    Miami dataset (always reliable for demos).
USE_LIVE_DATA=false

# 4) Real backend (Supabase) — posts, follows, comments, likes, saves,
#    and profiles sync across real users + devices. Leave BLANK to use
#    the built-in localStorage fallback (zero-config demo).
#    Setup: create a project at supabase.com → SQL Editor → run
#    supabase/schema.sql then supabase/seed.sql → Project Settings → API
#    → copy the URL + anon/public key below. (Auth → Providers → Email:
#    turn OFF "Confirm email" for a frictionless beta.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
